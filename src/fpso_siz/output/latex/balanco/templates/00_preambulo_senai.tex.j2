        & \textbf{PROGRAMA:} \hfill \DocPrograma
        & \textbf{FOLHA:} \hfill \textbf{\thepage}
          \textbf{de} \textbf{\pageref{LastPage}}
        \tabularnewline \cline{2-3}

        & \textbf{TÍTULO:} \hfill
          \textbf{\fontsize{7}{8}\selectfont \DocTitulo}
        & \hfill
          \IfFileExists{\LogoPath}
              {\includegraphics[width=18mm,keepaspectratio]{\LogoPath}}
              {\textbf{SENAI CETIQT}}
