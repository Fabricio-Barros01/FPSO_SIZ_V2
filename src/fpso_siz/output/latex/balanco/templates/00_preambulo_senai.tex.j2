% Largura útil exata da moldura (210mm - 10mm - 10mm = 190mm)
\newlength{\FrameWidth}
\setlength{\FrameWidth}{\dimexpr\paperwidth - \BorderMarginLeft - \BorderMarginRight\relax}

% Configuração do Geometry para área útil do texto (páginas 2+)
