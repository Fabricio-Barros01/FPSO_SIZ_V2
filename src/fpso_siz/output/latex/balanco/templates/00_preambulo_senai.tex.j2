% =========================================================
% DESENHO DA MOLDURA FÍSICA EXTERNA (TIKZ OVERLAY)
% =========================================================

\newcommand{\DesenharMolduraExterna}{%
    \begin{tikzpicture}[remember picture, overlay]
        \draw[line width=0.8pt, black] 
            ([xshift=\BorderMarginLeft, yshift=-\BorderMarginTop] current page.north west) 
            rectangle 
            ([xshift=-\BorderMarginRight, yshift=\BorderMarginBottom] current page.south east);
    \end{tikzpicture}%
}

% =========================================================
% CABEÇALHO DA FOLHA DE ROSTO (CAPA)
% =========================================================

\newcommand{\CabecalhoRosto}{%
    \vspace{7.2pt}%
    \setlength{\parindent}{0pt}%
    \setlength{\extrarowheight}{1.5pt}%
    \fontsize{8}{9.5}\selectfont
    \hspace*{-5mm}%
    \begin{tabularx}{\FrameWidth}{|M{32mm}|X|M{52mm}|}
        \hline
        \multirow{4}{*}{%
            \IfFileExists{\LogoPath}
                {\includegraphics[width=28mm,keepaspectratio]{\LogoPath}}
                {\textbf{SENAI CETIQT}}%
        }
        & \textbf{\DocTipo}
        & \textbf{Nº:} \hfill \textbf{\DocNumero}
        \tabularnewline \cline{2-3}

        & \textbf{CLIENTE:} \hfill \DocCliente
        & \textbf{FOLHA:} \hfill \textbf{1} \textbf{de} \textbf{\pageref{LastPage}}
        \tabularnewline \cline{2-3}

        & \textbf{PROGRAMA:} \hfill \DocPrograma
        &
        \tabularnewline \cline{2-3}

        & \textbf{ÁREA:} \hfill \textbf{\DocArea}
        &
        \tabularnewline \hline

        \multicolumn{3}{|c|}{%
            \textbf{TÍTULO: \DocTitulo}%
        }
        \tabularnewline \hline

        \multirow{2}{*}{%
            \IfFileExists{\LogoPath}
                {\includegraphics[width=26mm,keepaspectratio]{\LogoPath}}
                {\textbf{SENAI CETIQT}}%
        }
        &
        &
        \tabularnewline \cline{2-3}

        &
        \textbf{ARQUIVO Nº:}
        &
        \centering \textbf{\DocArquivo} \arraybackslash
        \tabularnewline \hline
    \end{tabularx}%
}

