        \hline
        \multirow{3}{*}{%
            \IfFileExists{\LogoPath}
                {\includegraphics[width=26mm,keepaspectratio]{\LogoPath}}
                {\textbf{SENAI CETIQT}}%
        }
        & \textbf{\DocTipo}
        & \textbf{Nº:} \quad \textbf{\DocNumero}
          \hfill \textbf{REV.} \textbf{\DocRevisao}
