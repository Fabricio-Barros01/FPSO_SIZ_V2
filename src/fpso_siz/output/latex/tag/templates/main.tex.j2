\paragraph{Busca na grade e formação do envelope}
Diâmetro mínimo: << n(d.passos.d_min, True) >>; máximo: << n(d.passos.d_max, True) >>;
passo: << n(d.passos.d_step, True) >>. Banda de esbeltez:
<< n(d.passos.sr_min) >> a << n(d.passos.sr_max) >>; alvo: << n(d.passos.sr_target) >>.
