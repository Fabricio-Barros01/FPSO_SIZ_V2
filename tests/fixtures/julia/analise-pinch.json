perada":0.5294117647058824,"n_correntes":4.0,"n_frias":2.0,"n_intervalos":7.0,"n_pinch":1.0,"n_quentes":2.0,"q_cold":470.0,"q_hot":510.0,"qcmin":240.0,"qhmin":200.0,"recuperacao":270.0,"t_pinch_deslocada":105.0,"t_pinch_fria":80.0,"t_pinch_quente":130.0,"threshold":0.0},"driver_case":"Tabela 2.2 — as quatro correntes do livro","governing":"utilidade_quente","ok":true,"per_case_y":[200.0],"tem_presentation":true,"x":50.0,"y":200.0}],"slack":[0.0],"x":10.0,"y":20.0},"equipment":"pinch","equipment_label":"Rede térmica de processo","exemplo":"exemplo_pinch_kemp","expansao":[{"name":"Tabela 2.2 — as quatro correntes do livro","values":{"corrente_1_mcp":2.0,"corrente_1_t_in":20.0,"corrente_1_t_out":135.0,"corrente_2_mcp":3.0,"corrente_2_t_in":170.0,"corrente_2_t_out":60.0,"corrente_3_mcp":4.0,"corrente_3_t_in":80.0,"corrente_3_t_out":140.0,"corrente_4_mcp":1.5,"corrente_4_t_in":150.0,"corrente_4_t_out":30.0}}],"global_keys":["dt_min_min","dt_min_max","dt_min_step","dt_min_alvo"],"governing_summary":"Governa: utilidade quente (QHmin), pelo caso 'Tabela 2.2 — as quatro correntes do livro'.","label":"Kemp — Problem Table (alvos de energia)","method":"pinch_kemp","parameter_groups":[{"key":"corrente","label":"Corrente","max":12,"min":2}],"parameters":[{"advanced":false,"default":150.0,"group":"corrente","instance":0,"key":"t_in","label":"Temperatura de entrada","max":1000.0,"min":-200.0,"note":"Tabela 2.2, p. 21 — a temperatura de suprimento da corrente. Que a corrente seja quente ou fria é consequência do sinal de (entrada − saída), e não um campo à parte: o passo 2 de §3.9.1 (p. 95) desloca pelo sentido, e um rótulo de tipo poderia contradizer estes dois números. A faixa é limite de tela, não do algoritmo: §3.7.3 (p. 82) vai de criogenia a serviços de alta temperatura.","unit":"°C"},{"advanced":false,"default":60.0,"group":"corrente","instance":0,"key":"t_out","label":"Temperatura de saída","max":1000.0,"min":-200.0,"note":"Tabela 2.2, p. 21 — a temperatura de destino da corrente. Mudança de fase NÃO entra como CP infinito: §3.1.3, p. 44, manda manter a temperatura de suprimento e deslocar a de destino em ~0,1 °C — para cima se a corrente é fria (vaporizando), para baixo se é quente (condensando). Segmento isotérmico é recusado, com essa receita na mensagem.","unit":"°C"},{"advanced":false,"default":2.0,"group":"corrente","instance":0,"key":"mcp","label":"Capacidade calorífica de fluxo ṁ·cp","max":10000.0,"min":0.001,"note":"Tabela 2.2, p. 21 — o CP da corrente. É uma TAXA (ṁ·cp), não uma propriedade: multiplicado pelo ΔT do intervalo dá o ΔH da Eq. (2.3), p. 21. Constante por trecho; quando o CP real varia com a temperatura, §3.1.3 (p. 45) manda linearizar em seções, que é o remédio que o livro recomenda e o que os segmentos existem para permitir.","unit":"kW/°C"},{"advanced":false,"default":10.0,"group":"none","instance":0,"key":"dt_min_alvo","label":"ΔTmin adotado","max":100.0,"min":1.0,"note":"§3.7.3, p. 82: para serviços correntes de líquidos de escoamento livre, 20 °C é um ΔTmin razoável; para altas vazões ou operação contínua em três turnos — que é literalmente o caso de um FPSO — 10 °C é mais apropriado. Duas ressalvas que a página faz e que é fácil deturpar: para criogenia a fonte dá 2–3 K (não 3–5 °C), e ela explica o ΔTmin ALTO por U baixo e capital caro (o ótimo migra para 30 °C com U pela metade e 50 °C com U a um quinto), NÃO por energia barata. SELEÇÃO POR DECLARAÇÃO: o programa cumpre este valor, não o escolhe — sem modelo de área e capital não há a curva de custo total do §3.7 (Figura 3.25) e não há ótimo a procurar.","unit":"°C"},{"advanced":true,"default":5.0,"group":"none","instance":0,"key":"dt_min_min","label":"ΔTmin mínimo da grade","max":100.0,"min":1.0,"note":"Ponta inferior da faixa do §3.7.2, p. 82: o custo total fica a cerca de 10 % do ótimo entre aproximadamente 5 °C e 50 °C. A varredura percorre justamente essa faixa, que é onde a fonte declara a escolha ser barata — dez para um em ΔTmin, dentro de 10 % em custo.","unit":"°C"},{"advanced":true,"default":50.0,"group":"none","instance":0,"key":"dt_min_max","label":"ΔTmin máximo da grade","max":100.0,"min":1.0,"note":"Ponta superior da mesma faixa do §3.7.2, p. 82 (cerca de 5 °C a 50 °C, dentro de ~10 % do ótimo). Acima dela o §3.7.3 só registra os casos de U baixo, em que o ótimo migra para 30–50 °C; o teto de 100 °C do descritor existe para não impedi-los.","unit":"°C"},{"advanced":true,"default":1.0,"group":"none","instance":0,"key":"dt_min_step","label":"Passo da grade de ΔTmin","max":10.0,"min":0.1,"note":"Resolução da varredura — escolha NUMÉRICA, e a fonte não publica grade nenhuma. 1 °C é fino o bastante para percorrer os 5–50 °C do §3.7.2 (p. 82) e grosso o bastante para a tabela continuar legível. Um limiar como os 5,55 °C do §3.3.2 (p. 54) cai ENTRE dois pontos da grade: ele se lê na coluna de QHmin, que zera, e não na de ΔTmin.","unit":"°C"}],"requirement_spec":["utilidade quente mínima QHmin","kW"],"result_fields":[{"digits":2,"highlight":false,"label":"O que esta tela entrega","status":"neutro","unit":"","value":"Metas de energia da rede (QHmin, QCmin) e a temperatura de pinch. NÃO dimensiona casco-e-tubos e NÃO sintetiza a rede de trocadores."},{"digits":2,"highlight":true,"label":"ΔTmin adotado","status":"neutro","unit":"°C","value":10.0},{"digits":1,"highlight":true,"label":"Utilidade quente mínima QHmin","status":"neutro","unit":"kW","value":20.0},{"digits":1,"highlight":true,"label":"Utilidade fria mínima QCmin","status":"neutro","unit":"kW","value":60.0},{"digits":1,"highlight":false,"label":"Calor recuperado na rede","status":"neutro","unit":"kW","value":450.0},{"digits":3,"highlight":false,"label":"Fração da carga quente recuperada","status":"neutro","unit":"","value":0.8823529411764706},{"digits":2,"highlight":false,"label":"Situação do pinch","status":"neutro","unit":"","value":"um pinch"},{"digits":2,"highlight":false,"label":"T de pinch (deslocada)","status":"neutro","unit":"°C","value":85.0},{"digits":2,"highlight":false,"label":"T de pinch, lado quente","status":"neutro","unit":"°C","value":90.0},{"digits":2,"highlight":false,"label":"T de pinch, lado frio","status":"neutro","unit":"°C","value":80.0},{"digits":0,"highlight":false,"label":"Correntes na rede","status":"neutro","unit":"","value":4.0},{"digits":2,"highlight":false,"label":"Quentes / frias","status":"neutro","unit":"","value":"2 / 2"},{"digits":0,"highlight":false,"label":"Intervalos de temperatura","status":"neutro","unit":"","value":5.0},{"digits":1,"highlight":false,"label":"Carga quente disponível ΣQ","status":"neutro","unit":"kW","value":510.0},{"digits":1,"highlight":false,"label":"Carga fria requerida ΣQ","status":"neutro","unit":"kW","value":470.0},{"digits":3,"highlight":false,"label":"Resíduo do balanço de entalpia","status":"ok","unit":"kW","value":0.0},{"digits":2,"highlight":false,"label":"Cenário governante","status":"neutro","unit":"","value":"Tabela 2.2 — as quatro correntes do livro"}],"stream_keys":[],"stream_parameters":[],"sweep_columns":[{"digits":1,"key":"x","label":"ΔTmin (°C)"},{"digits":1,"key":"y","label":"QHmin (kW)"},{"digits":1,"key":"qcmin","label":"QCmin (kW)"},{"digits":1,"key":"recuperacao","label":"recuperado (kW)"},{"digits":1,"key":"t_pinch_deslocada","label":"T pinch (°C)"}],"trace_blocks":[{"key":"correntes","title":"Bloco A — as correntes e as cargas (Tabela 2.2, p. 21)"},{"key":"selection","title":"Seleção do ΔTmin"}]}
